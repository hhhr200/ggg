# העתיקו קובץ זה ל-.env.local (בפרויקט מקומי) והזינו את הערכים האמיתיים שלכם.
# .env.local לא מועלה ל-Git (הוא כבר ב-.gitignore).
#
# בפרודקשן (Vercel) הזינו את אותם המפתחות תחת:
# Project Settings → Environment Variables

VITE_TELEGRAM_BOT_TOKEN=your_bot_token_here
VITE_TELEGRAM_CHAT_ID=your_chat_id_here
